[flake8]
max-line-length = 119
# E203 / W503 conflict with Black's formatting.
extend-ignore = E203, W503
# Re-export packages legitimately import names they don't use locally.
per-file-ignores =
    __init__.py:F401
exclude =
    .git,
    __pycache__,
    migrations,
    venv,
    .venv,
    static,
    media,
    private,
    conf
